# Network: testnet | mainnet
STELLAR_NETWORK=testnet

# Horizon endpoint
HORIZON_URL=https://horizon-testnet.stellar.org

# Fee polling interval (seconds)
POLL_INTERVAL_SECONDS=10

# API server port (default: 8080)
API_PORT=8080

# Allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# Cache TTL for /fees/current responses (seconds)
CACHE_TTL_SECONDS=5

# Rate limiting (requests per minute per IP, default: 60)
RATE_LIMIT_PER_MINUTE=60

# Retention window for fee data in SQLite (days, default: 7)
STORAGE_RETENTION_DAYS=7

# Retry config
RETRY_ATTEMPTS=3
BASE_RETRY_DELAY_MS=1000

# API key for protected routes (leave unset to disable auth)
# API_KEY=your-secret-key-here

# Webhook URL for fee spike alerts (leave unset to disable)
# WEBHOOK_URL=https://hooks.slack.com/services/xxx

# Alert threshold: Minor | Moderate | Major | Critical (default: Major)
ALERT_THRESHOLD=Major

# SQLite database URL (default: sqlite://stellar_fees.db)
DATABASE_URL=sqlite://stellar_fees.db

# Fallback for API_PORT when it is unset (e.g. injected by Render)
# PORT=8080

# Comma-separated alert types to evaluate: spike,recovery,good_window,stale_data (default: all)
# ENABLED_ALERT_TYPES=spike,recovery,good_window,stale_data

# Seconds before data is considered stale for stale_data alerts (default: 300)
# STALE_DATA_THRESHOLD_SECONDS=300

# Fee recommendation engine tuning (values shown are the built-in defaults)
# REC_DEFAULT_CONFIDENCE=0.95
# REC_DEFAULT_LEDGERS=2
# REC_HISTORY_WINDOW_SECS=10800
# REC_CACHE_TTL_SECS=10
# REC_MIN_SAMPLE_COUNT=10
