# Development-only image: runs the Next.js dev server with hot reload.
# It is not suitable for production (no `next build`, no production start);
# docker-compose.yml uses it for local work only.
FROM node:20-alpine

WORKDIR /app
# WORKDIR creates /app as root; hand it to the unprivileged `node` user that
# ships with the image before dropping privileges.
RUN chown node:node /app

USER node

COPY --chown=node:node package*.json ./
# `npm ci` installs exactly what package-lock.json pins, so the image does not
# drift from the lockfile the way `npm install` can.
RUN npm ci

COPY --chown=node:node . .

EXPOSE 3000

# Bind to all interfaces so the published port is reachable from the host.
CMD ["npm", "run", "dev", "--", "-H", "0.0.0.0"]
