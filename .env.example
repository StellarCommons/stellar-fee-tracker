# Required
STELLAR_NETWORK=testnet           # testnet or mainnet
POLL_INTERVAL_SECONDS=10          # Required (or pass --poll-interval)

# Optional (with defaults shown)
HORIZON_URL=                      # Defaults to network's public Horizon
API_PORT=8080
DATABASE_URL=sqlite://stellar_fees.db
CACHE_TTL_SECONDS=5
STORAGE_RETENTION_DAYS=7
RETRY_ATTEMPTS=3
BASE_RETRY_DELAY_MS=1000
RATE_LIMIT_PER_MINUTE=60
ALLOWED_ORIGINS=http://localhost:3000
API_KEY=                          # Leave empty to disable auth
WEBHOOK_URL=                      # Leave empty to disable alerts
ALERT_THRESHOLD=Major
ENABLED_ALERT_TYPES=spike,recovery,good_window,stale_data
STALE_DATA_THRESHOLD_SECONDS=300
REC_DEFAULT_CONFIDENCE=0.95
REC_DEFAULT_LEDGERS=2
REC_HISTORY_WINDOW_SECS=10800
REC_CACHE_TTL_SECS=10
REC_MIN_SAMPLE_COUNT=10
PORT=                             # Fallback for API_PORT when it is unset
RUST_LOG=info
